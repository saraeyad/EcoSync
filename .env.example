# Gemini (optional chatbot)
VITE_GEMINI_API_KEY=

# Supabase — required for live dashboard data on Vercel
# If the project is paused/deleted, DNS will fail and the UI falls back to demo data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_legacy_anon_jwt...
# Optional alias (legacy publishable key name used in some setups)
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
